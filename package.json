{
  "name": "forma-li",
  "version": "1.0.18",
  "description": "Collection of useful utility functions for JavaScript/TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./arrays": {
      "import": "./dist/arrays/index.mjs",
      "require": "./dist/arrays/index.js",
      "types": "./dist/arrays/index.d.ts"
    },
    "./strings": {
      "import": "./dist/strings/index.mjs",
      "require": "./dist/strings/index.js",
      "types": "./dist/strings/index.d.ts"
    },
    "./objects": {
      "import": "./dist/objects/index.mjs",
      "require": "./dist/objects/index.js",
      "types": "./dist/objects/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.mjs",
      "require": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=13.0.0",
    "swr": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "swr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "8.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "keywords": [
    "utils",
    "helpers",
    "functions",
    "typescript"
  ],
  "author": "Mohammad Felfelani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfelfelani72/next-forma-li"
  }
}